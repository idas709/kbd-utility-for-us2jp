import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct DeviceItem {
    name: string,
    instance_id: string,
    is_connected: bool,
    layout_mode: string,       // "passthrough" | "us-to-jis" | "jis-to-us"
    ctrl_ime_enabled: bool,
}

export component MainWindow inherits Window {
    title: "HID Keyboard Layout Remapper (Standalone)";
    preferred-width: 820px;
    preferred-height: 600px;
    min-width: 700px;
    min-height: 500px;
    background: #f3f3f3;

    in-out property <bool> global_enabled: true;
    in-out property <string> engine_status: "Standalone Engine: Active";
    in-out property <[DeviceItem]> devices: [];

    callback toggle_global_enabled(bool);
    callback change_device_layout(int, string);
    callback toggle_device_ctrl_ime(int, bool);
    callback refresh_devices();
    callback save_configuration();
    callback hide_window();

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // Header bar with status and Global switch
        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000015;
            height: 70px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "HID Keyboard Layout Remapper";
                        font-size: 18px;
                        font-weight: 700;
                        color: #1a1a1a;
                    }
                    Text {
                        text: engine_status;
                        font-size: 12px;
                        color: #0078d4;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;

                    CheckBox {
                        text: "Remap Active";
                        checked <=> root.global_enabled;
                        toggled => { root.toggle_global_enabled(self.checked); }
                    }

                    Button {
                        text: "Refresh";
                        clicked => { root.refresh_devices(); }
                    }

                    Button {
                        text: "Save & Apply";
                        primary: true;
                        clicked => { root.save_configuration(); }
                    }

                    Button {
                        text: "Hide to Tray";
                        clicked => { root.hide_window(); }
                    }
                }
            }
        }

        // Main Device List Card
        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000015;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Detected Keyboards (" + root.devices.length + ")";
                        font-size: 15px;
                        font-weight: 600;
                        color: #333333;
                    }
                    Text {
                        text: "Select layout mode & Ctrl IME toggle for each keyboard";
                        font-size: 11px;
                        color: #777777;
                    }
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 8px;

                        for dev[idx] in root.devices: Rectangle {
                            background: dev.is_connected ? #f8f9fa : #efefef;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: dev.is_connected ? #0078d4 : #cccccc;
                            height: 68px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                // Left: Device info
                                VerticalLayout {
                                    alignment: center;
                                    width: 320px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: dev.name;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: #111111;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: dev.is_connected ? "[Connected]" : "[Disconnected]";
                                            font-size: 11px;
                                            color: dev.is_connected ? #008000 : #888888;
                                        }
                                    }

                                    Text {
                                        text: dev.instance_id;
                                        font-size: 11px;
                                        color: #666666;
                                        overflow: elide;
                                    }
                                }

                                // Right: Controls
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 16px;

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Layout Mode:";
                                            font-size: 11px;
                                            color: #555555;
                                        }
                                        ComboBox {
                                            width: 130px;
                                            model: ["passthrough", "us-to-jis", "jis-to-us"];
                                            current-value: dev.layout_mode;
                                            selected(val) => {
                                                root.change_device_layout(idx, val);
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Ctrl IME:";
                                            font-size: 11px;
                                            color: #555555;
                                        }
                                        CheckBox {
                                            text: "L:OFF / R:ON";
                                            checked: dev.ctrl_ime_enabled;
                                            toggled => {
                                                root.toggle_device_ctrl_ime(idx, self.checked);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

