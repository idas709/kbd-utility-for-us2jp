import { ScrollView } from "std-widgets.slint";

export struct DeviceItem {
    name: string,
    instance_id: string,
    is_connected: bool,
    layout_mode: string,       // "passthrough" | "us-to-jis" | "jis-to-us"
    ctrl_ime_enabled: bool,
    is_active_typing: bool,    // whether key was recently pressed on this keyboard
}

component ActionBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();

    height: 36px;
    border-radius: 6px;
    background: primary ? (touch.has-hover ? #106ebe : #0078d4) : (touch.has-hover ? #e9ecef : #f8f9fa);
    border-width: 1.5px;
    border-color: primary ? #005a9e : #ced4da;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        font-size: 13px;
        font-weight: 600;
        color: primary ? #ffffff : #212529;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ModePill inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: selected ? #0078d4 : (touch.has-hover ? #e2e6ea : #ffffff);
    border-width: 1.5px;
    border-color: selected ? #005a9e : #cccccc;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        font-size: 11px;
        font-weight: selected ? 700 : 600;
        color: selected ? #ffffff : #333333;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CustomCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 32px;
    background: transparent;

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                background: root.checked ? #0078d4 : #ffffff;
                border-width: 1.5px;
                border-color: root.checked ? #005a9e : #666666;

                if root.checked : Text {
                    text: "✔";
                    font-size: 11px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.text;
                font-size: 13px;
                font-weight: 600;
                color: #212529;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "HID Keyboard Layout Remapper (Standalone)";
    icon: @image-url("assets/icon.png");
    preferred-width: 960px;
    preferred-height: 660px;
    min-width: 840px;
    min-height: 560px;
    background: #f4f5f7;

    in-out property <bool> global_enabled: true;
    in-out property <string> engine_status: "Standalone Engine: Active (Zero Install & Hotplug Detection)";
    in-out property <string> live_input_log: "Press keys to test remapping and IME switching...";
    in-out property <string> save_toast_text: "";
    in-out property <bool> show_save_toast: false;
    in-out property <[DeviceItem]> devices: [];

    callback toggle_global_enabled(bool);
    callback change_device_layout(int, string);
    callback toggle_device_ctrl_ime(int, bool);
    callback refresh_devices();
    callback save_configuration();
    callback hide_window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header Card
        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000015;
            height: 64px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 14px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: "HID Keyboard Layout Remapper";
                        font-size: 17px;
                        font-weight: 700;
                        color: #111111;
                    }
                    Text {
                        text: engine_status;
                        font-size: 12px;
                        font-weight: 500;
                        color: #0078d4;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;

                    CustomCheckBox {
                        text: "リマップ有効";
                        checked: root.global_enabled;
                        toggled(val) => { root.toggle_global_enabled(val); }
                    }

                    ActionBtn {
                        width: 95px;
                        text: "🔄 再検出";
                        primary: false;
                        clicked => { root.refresh_devices(); }
                    }

                    ActionBtn {
                        width: 140px;
                        text: "💾 Save & Apply";
                        primary: true;
                        clicked => { root.save_configuration(); }
                    }

                    ActionBtn {
                        width: 80px;
                        text: "トレイへ";
                        primary: false;
                        clicked => { root.hide_window(); }
                    }
                }
            }
        }

        // Live Monitor / Save Toast Unified Banner
        Rectangle {
            background: root.show_save_toast ? #d4edda : #e7f3ff;
            border-radius: 6px;
            border-width: 1.5px;
            border-color: root.show_save_toast ? #28a745 : #0078d4;
            height: 44px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: root.show_save_toast ? "✔ 保存ステータス:" : "Live Monitor:";
                        font-size: 13px;
                        font-weight: 700;
                        color: root.show_save_toast ? #155724 : #004578;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.show_save_toast ? root.save_toast_text : root.live_input_log;
                        font-size: 13px;
                        font-weight: 600;
                        color: root.show_save_toast ? #155724 : #106ebe;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if root.show_save_toast : VerticalLayout {
                    alignment: center;
                    Text {
                        text: "[ 設定反映完了 / Applied ]";
                        font-size: 12px;
                        font-weight: 700;
                        color: #155724;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Main Device List Card
        Rectangle {
            background: #ffffff;
            border-radius: 8px;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000015;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "接続中のキーボード (" + root.devices.length + "台)";
                        font-size: 15px;
                        font-weight: 700;
                        color: #212529;
                    }
                    Text {
                        text: "キーボードごとにボタンをクリックして配列変換モードを選択してください（即時反映）";
                        font-size: 12px;
                        color: #6c757d;
                    }
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 10px;

                        for dev[idx] in root.devices: Rectangle {
                            background: dev.is_active_typing ? #e6f4ea : #f8f9fa;
                            border-radius: 6px;
                            border-width: dev.is_active_typing ? 2px : 1px;
                            border-color: dev.is_active_typing ? #137333 : #dee2e6;
                            height: 76px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                // Left: Device info
                                VerticalLayout {
                                    alignment: center;
                                    width: 380px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: dev.name;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: #111111;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: dev.is_connected ? "[接続中]" : "[切断]";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: dev.is_connected ? #198754 : #6c757d;
                                        }
                                    }

                                    Text {
                                        text: dev.instance_id;
                                        font-size: 11px;
                                        color: #6c757d;
                                        overflow: elide;
                                    }
                                }

                                // Right: Controls
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 24px;

                                    // Layout Mode Segmented Pill Buttons
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: "配列変換モード (Layout):";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #495057;
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;

                                            ModePill {
                                                width: 82px;
                                                height: 28px;
                                                text: "US → JIS";
                                                selected: dev.layout_mode == "us-to-jis";
                                                clicked => {
                                                    root.change_device_layout(idx, "us-to-jis");
                                                }
                                            }

                                            ModePill {
                                                width: 82px;
                                                height: 28px;
                                                text: "JIS → US";
                                                selected: dev.layout_mode == "jis-to-us";
                                                clicked => {
                                                    root.change_device_layout(idx, "jis-to-us");
                                                }
                                            }

                                            ModePill {
                                                width: 90px;
                                                height: 28px;
                                                text: "Passthrough";
                                                selected: dev.layout_mode == "passthrough";
                                                clicked => {
                                                    root.change_device_layout(idx, "passthrough");
                                                }
                                            }
                                        }
                                    }

                                    // Ctrl IME CheckBox
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: "IME切替 (Ctrl):";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #495057;
                                        }

                                        CustomCheckBox {
                                            height: 28px;
                                            text: "左:OFF / 右:ON";
                                            checked: dev.ctrl_ime_enabled;
                                            toggled(val) => {
                                                root.toggle_device_ctrl_ime(idx, val);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
